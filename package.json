{
  "name": "dse-me-simulator",
  "version": "0.1.0",
  "description": "DSE-ME Simulator — Exchange-side FIX Protocol and Matching Engine Simulator for the Dhaka Stock Exchange",
  "main": "src/index.js",
  "author": "QFL Engineering",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:e2e": "jest tests/e2e --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:migration:create": "sequelize-cli migration:create",
    "db:seed": "sequelize-cli db:seed:all",
    "client:test": "node scripts/test-fix-client.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:standalone": "docker compose -f docker-compose.standalone.yml up -d",
    "lint": "eslint src/ tests/ --ext .js"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "ejs": "^3.0.0",
    "express": "^4.18.0",
    "fixparser": "^7.0.0",
    "mysql2": "^3.0.0",
    "pino": "^8.0.0",
    "sequelize": "^6.0.0",
    "socket.io": "^4.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "pino-pretty": "^10.0.0",
    "sequelize-cli": "^6.0.0",
    "sqlite3": "^6.0.1",
    "supertest": "^6.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/db/migrations/**",
      "!src/db/seeders/**"
    ]
  }
}
