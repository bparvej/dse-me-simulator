# ============================================================
# DSE-ME Simulator — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.
# ============================================================

# -------------------------------------------------------
# Application
# -------------------------------------------------------
NODE_ENV=development
APP_NAME=DSE-ME Simulator
LOG_LEVEL=info

# Operating mode: PROTOCOL or EXCHANGE
OPERATING_MODE=PROTOCOL

# -------------------------------------------------------
# HTTP Server (Dashboard + Admin API)
# -------------------------------------------------------
HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# -------------------------------------------------------
# FIX TCP Acceptor
# -------------------------------------------------------
FIX_TCP_PORT=9876
FIX_TCP_HOST=0.0.0.0

# -------------------------------------------------------
# FIX Session Configuration
# -------------------------------------------------------
# Simulator CompID (SenderCompID on outbound messages)
FIX_SENDER_COMP_ID=DSESIM

# Expected OMS CompID (TargetCompID on inbound messages)
FIX_TARGET_COMP_ID=OMSFIRM

# Session protocol
FIX_BEGIN_STRING=FIXT.1.1

# Application protocol version ID
# 7 = FIX.5.0
# UNVERIFIED: Confirm this value against the DSE counterparty profile.
FIX_DEFAULT_APPL_VER_ID=7

# Heartbeat interval in seconds
FIX_HEARTBEAT_INTERVAL=30

# Maximum SendingTime latency in seconds
FIX_MAX_LATENCY=120

# Extra seconds before sending Test Request if no heartbeat received
FIX_HEARTBEAT_TOLERANCE=10

# Seconds to wait for Logout response before force-closing
FIX_LOGOUT_RESPONSE_TIMEOUT=10

# -------------------------------------------------------
# Database (MySQL 8)
# -------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dse_me_simulator
DB_USER=dse_sim_user
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_POOL_MIN=2
DB_POOL_MAX=10

# -------------------------------------------------------
# FIX Message Archive
# -------------------------------------------------------
# Base directory for archive files (must be on persistent storage)
ARCHIVE_BASE_DIR=storage/fix-archive

# Maximum consecutive archive write failures before controlled shutdown
ARCHIVE_FAIL_THRESHOLD=10

# Compute SHA-256 hash of each archived message (true/false)
ARCHIVE_ENABLE_SHA256=false

# Number of days to retain archive files (0 = never delete)
ARCHIVE_RETENTION_DAYS=0
